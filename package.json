{
	"name": "persona-selfie-killchain",
	"description": "Persona FAS Gallery running on Vite and Cloudflare Workers",
	"dependencies": {
		"@mediapipe/tasks-vision": "^0.10.35",
		"d3-force": "^3.0.0",
		"framer-motion": "^12.42.2",
		"hono": "4.13.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "^8.3.0",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.51.0",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/d3-force": "^3.0.10",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@types/three": "^0.185.1",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.3.6",
		"wrangler": "4.119.0"
	},
	"overrides": {
		"@babel/core": "^7.29.7",
		"brace-expansion@^1": "^1.1.18",
		"brace-expansion@^2": "^2.1.4",
		"js-yaml": "^4.3.1",
		"postcss": "^8.5.26",
		"undici": "^7.29.0"
	},
	"private": true,
	"scripts": {
		"build:index": "tsx scripts/build-gallery-index.ts",
		"build": "tsc -b && vite build",
		"build:staging": "CLOUDFLARE_ENV=staging npm run build",
		"build:prod": "CLOUDFLARE_ENV=production npm run build",
		"cf-typegen": "wrangler types",
		"check": "tsc && npm run build:staging && wrangler deploy --dry-run",
		"deploy": "npm run deploy:staging",
		"deploy:staging": "npm run build:staging && wrangler deploy",
		"deploy:prod": "npm run build:prod && wrangler deploy",
		"dev": "lsof -ti:8787 | xargs kill -9 2>/dev/null || true && CLOUDFLARE_ENV=staging vite dev",
		"lint": "eslint .",
		"preview": "npm run build && vite preview"
	},
	"type": "module"
}
